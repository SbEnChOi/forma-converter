{
  "name": "forma-converter",
  "productName": "Forma",
  "version": "1.3.0",
  "description": "사진과 문서를 이 컴퓨터에서 변환하는 앱",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Forma",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build": "npm run build:vendor && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:app": "node scripts/check-app.mjs",
    "package": "npm run build && electron-builder --win dir nsis --x64"
  },
  "build": {
    "appId": "local.forma.converter",
    "productName": "Forma",
    "artifactName": "Forma-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "engine/**/*",
      "vendor/handoc.mjs",
      "vendor/handoc/LICENSE",
      "assets/**/*",
      "LICENSE",
      "README.md",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/@img/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/@rhwp/core/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forma",
      "runAfterFinish": false,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@rhwp/core": "0.8.7",
    "bmp-js": "0.1.0",
    "cfb": "1.2.2",
    "docx": "9.15.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "heic-convert": "2.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5",
    "svg-to-pdfkit": "0.1.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.66.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
